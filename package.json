{
  "name": "hornalla",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hornalla: herramientas gratuitas para comedores y merenderos (calculadora con datos oficiales del INDEC, página para donantes y mapa de organizaciones). Sitio estático.",
  "author": "Santino Spingola",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "datos:canasta": "node scripts/build-canasta-data.mjs",
    "datos:precios": "node scripts/build-precios-data.mjs",
    "datos:organizaciones": "node scripts/build-organizaciones.mjs",
    "datos:organizaciones:demo": "node scripts/build-organizaciones.mjs --demo",
    "datos:estado": "node scripts/estado-datos.mjs",
    "datos:cambiaron": "node scripts/datos-cambiaron.mjs",
    "desplegar": "vite build && node scripts/desplegar.mjs",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "indec-mcp": "^0.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4"
  }
}
